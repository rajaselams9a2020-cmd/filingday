APP_NAME=examate-rag
ENVIRONMENT=local
# Add API keys here later. Never commit the real .env file.
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=fake-model
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3


LLM_BACKOFF_BASE_SECONDS=0.5

# Optional fallback; blank means disabled
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# Zero means no cost is calculated (fake/local use)
PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0
COST_LOG_PATH=logs/cost.jsonl